# RWA Platform — frontend environment variables (Next.js).
#
# Local development: copy this file to `.env.local` (git-ignored, loaded automatically):
#   cp .env.example .env.local
# Production builds: provide the same variables in the build environment;
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time.

# WalletConnect Cloud project id (https://cloud.walletconnect.com), used by RainbowKit.
# Code fallback when unset: YOUR_PROJECT_ID
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=YOUR_PROJECT_ID

# GraphQL gateway endpoint (queries/mutations; SSE stream = <endpoint>/stream).
# Code fallback when unset: http://localhost:443/gateway/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:443/gateway/graphql

# Gateway HTTP base for REST calls (file uploads: documents/gallery/pool/business images).
# Code fallback when unset: http://localhost:443
NEXT_PUBLIC_API_ENDPOINT=http://localhost:443

# Base URL for rendered uploaded files; must end with a slash.
# Code fallback when unset: https://192.168.100.20/files/
NEXT_PUBLIC_FILE_ENDPOINT=https://192.168.100.20/files/
